# Kopiér til .env og udfyld. .env må aldrig committes (repoet er offentligt).

# Engangsnøgle fra https://login.tailscale.com/admin/settings/keys
# Bruges kun første gang. Derefter ligger Tailscales tilstand i en volume.
TS_AUTHKEY=tskey-auth-...

# Tilfældig nøgle til login-cookien. Lav en med:  openssl rand -hex 32
# Skiftes den, bliver alle logget ud.
APP_SECRET=
