# Kopiér til .env og udfyld. .env må aldrig committes (repoet er offentligt).
# Brug IKKE de samme værdier som i driften (../.env).

# Ny engangsnøgle fra https://login.tailscale.com/admin/settings/keys
# Bruges kun første gang. Derefter ligger Tailscales tilstand i en volume.
TS_AUTHKEY=tskey-auth-...

# Egen nøgle til login-cookien. Lav en med:  openssl rand -hex 32
APP_SECRET=
